{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ba-key-amas",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [
    { "binding": "DB", "database_name": "ba-key-amas", "database_id": "9618548b-3a6d-4e44-aa20-386d85cdc887", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "CREATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": { "ADDON_URL": "https://github.com/whyjp/ba_key_amas/releases/latest" },
  "observability": { "enabled": true }
}
