# Local secrets. Copy this file to `.env` (which git ignores) and fill it in. Never commit the real values.
#
# The add-on signing key: the same value as the Cloudflare Worker secret ADDON_SIGNING_KEY and the GitHub Actions
# secret ADDON_SIGNING_KEY. With it here:
#   - `cargo build` / `cargo test` compile it into ba-key-AMAS.exe (scanner/crates/cli/build.rs reads this file), so a
#     local build signs its uploads like the official release does;
#   - `npm run dev` in web/ hands it to the local server (web/scripts/sync-dev-vars.ts writes web/.dev.vars);
#   - web/scripts/e2e-accounts.ps1 uses it for the end-to-end run.
# Generate a new one with: openssl rand -hex 32
BAOCR_ADDON_SIGNING_KEY=
