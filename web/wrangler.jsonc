{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ba-key-amas",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [
    { "binding": "DB", "database_name": "ba-key-amas", "database_id": "REPLACE_WITH_wrangler_d1_create_ID", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
