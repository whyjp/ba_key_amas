// Cloudflare Worker config. Nothing secret lives here.
// docs/DEPLOY.md lists the steps that only the account owner can do.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must equal the Worker name shown in the Cloudflare dashboard, or Workers Builds fails the build.
  "name": "ba-key-amas",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ba-key-amas",
      // The id of the database created in the Cloudflare console. An identifier, not a secret.
      "database_id": "9618548b-3a6d-4e44-aa20-386d85cdc887",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "CREATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // Keeps the secret out of the repository: set it once with `npx wrangler secret put KEY_PEPPER`
  // or in the dashboard under Settings > Variables and Secrets. A deploy without them fails instead of running unkeyed.
  // ADDON_SIGNING_KEY is the same value the release workflow compiles into the add-on (docs/DEPLOY.md).
  "secrets": { "required": ["KEY_PEPPER", "ADDON_SIGNING_KEY"] },
  // The add-on download link the server hands out. scripts/release-check.ps1 keeps it equal to release-contract.json.
  "vars": { "ADDON_URL": "https://github.com/whyjp/ba_key_amas/releases/latest" },
  "observability": { "enabled": true }
}
